# Copy to .env in this folder (asset-manager-backend) and fill in.
# .env is not in git and not in the server backup, so keep this list in step with index.js.

# Folder that holds the live data: assets.db and uploads\images, uploads\invoices.
# Leave it unset to keep the data in this folder, as before.
# On SWAPP it is the FAS folder under the shared data folder that Veeam backs up.
# Use a full path. FAS refuses to start if assets.db is not in that folder, so move
# the data there (with FAS stopped) before setting it.
DATA_DIR=E:\Apps\data\FAS

PORT=4000
# Comma separated browser origins allowed to call the API.
CORS_ORIGINS=http://<app-host>:<port>
# Comma separated addresses of the people allowed to sign in.
ALLOWED_EMAILS=<name>@<domain>,<name>@<domain>

# Also read by index.js, which falls back to a value written in the code when one is unset.
# Set SESSION_SECRET: the fallback is the same for every copy of this public repo.
# SESSION_SECRET=<long random string>
# Unset means the scanner cannot call the API with a token.
# SCAN_TOKEN=<token the scanner sends>
# LDAP_URL=ldap://<domain-controller>
# LDAP_BASE_DN=DC=<domain>,DC=<tld>
# LDAP_DEFAULT_UPN=<upn-suffix>
# LDAP_ALT_UPN=<upn-suffix>
# LDAP_NETBIOS=<NETBIOS>
# PYTHON=<path to python.exe for scanner.py>
