# dependencies / artifacts
node_modules/
build/
dist/

# local data & secrets
# The live data (assets.db and uploads) sits in DATA_DIR on the server, or in
# asset-manager-backend when DATA_DIR is unset; it never belongs in this public repo.
# Six invoice PDFs under uploads/invoices were committed before this rule and stay tracked
# until the server's uploads have moved to DATA_DIR: untracking them earlier would make a
# pull delete the live copies that FAS still serves from this folder.
assets.db
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
asset-manager-backend/uploads/
.env
.env.*
!.env.example

# tesseract.js language data, downloaded again on first OCR
asset-manager-backend/tessdata/

# misc
.DS_Store
